<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Mentor: incoming mentee applications. Rows are built in MenteeMenuController. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.herpathway.controller.MenteeMenuController"
      styleClass="page">

    <HBox alignment="CENTER_LEFT" spacing="16">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label styleClass="page-title" text="Mentee requests"/>
            <Label styleClass="page-subtitle" text="Review applications and accept the mentees you want to guide."/>
        </VBox>
        <Label fx:id="pendingCountLabel" styleClass="badge, badge-warning"/>
    </HBox>

    <VBox fx:id="requestList" spacing="12"/>
</VBox>
