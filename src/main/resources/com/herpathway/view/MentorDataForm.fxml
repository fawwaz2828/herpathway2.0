<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<!-- First-login onboarding form (full window). -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.herpathway.controller.MentorDataController"
            prefWidth="1180" prefHeight="720">
    <top>
        <HBox alignment="CENTER_LEFT" styleClass="top-bar">
            <padding><Insets top="16" right="32" bottom="16" left="32"/></padding>
            <ImageView fitHeight="28" preserveRatio="true"><Image url="@../../../image/logoHitam.png"/></ImageView>
            <Region HBox.hgrow="ALWAYS"/>
            <Label styleClass="muted" text="One last step: complete your profile"/>
        </HBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true" styleClass="content-scroll">
            <StackPane>
                <VBox styleClass="page" maxWidth="860">
                    <VBox spacing="4">
                        <Label styleClass="page-title" text="Set up your mentor profile"/>
                        <Label styleClass="page-subtitle" text="Mentees will see your education and career when choosing a mentor."/>
                    </VBox>
                    <VBox styleClass="card" spacing="14">
                        <Label styleClass="section-title" text="Photo and documents"/>
                        <Label styleClass="muted, small" text="Images (PNG/JPG), max 1 MB each. Used to verify your profile; only the photo is public."/>
                        <GridPane hgap="16" vgap="12">
                            <columnConstraints><ColumnConstraints minWidth="130"/><ColumnConstraints hgrow="ALWAYS"/><ColumnConstraints/></columnConstraints>
                            <Label styleClass="field-label" text="Profile photo" GridPane.rowIndex="0"/>
                            <Label fx:id="profilePictureNameLabel" styleClass="file-name" text="No file chosen" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                            <Button styleClass="btn-secondary" text="Choose file" onAction="#handleProfilePictureUploadAction" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                            <Label styleClass="field-label" text="ID card" GridPane.rowIndex="1"/>
                            <Label fx:id="idCardNameLabel" styleClass="file-name" text="No file chosen" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                            <Button styleClass="btn-secondary" text="Choose file" onAction="#handleIdCardUploadAction" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                            <Label styleClass="field-label" text="CV" GridPane.rowIndex="2"/>
                            <Label fx:id="cvNameLabel" styleClass="file-name" text="No file chosen" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                            <Button styleClass="btn-secondary" text="Choose file" onAction="#handleCvUploadAction" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                            <Label styleClass="field-label" text="Certificate" GridPane.rowIndex="3"/>
                            <Label fx:id="certificateNameLabel" styleClass="file-name" text="No file chosen" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                            <Button styleClass="btn-secondary" text="Choose file" onAction="#handleCertificateUploadAction" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                        </GridPane>
                    </VBox>
                    <VBox styleClass="card" spacing="14">
                        <Label styleClass="section-title" text="Personal info"/>
                        <GridPane hgap="16" vgap="14">
                            <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                <Label styleClass="field-label" text="Display name"/>
                                <TextField fx:id="displayNameField" promptText="How others see you"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <Label styleClass="field-label" text="Full name"/>
                                <TextField fx:id="realNameField" promptText=""/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                <Label styleClass="field-label" text="Email"/>
                                <TextField fx:id="emailField" promptText="you@example.com"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <Label styleClass="field-label" text="Phone number"/>
                                <TextField fx:id="phoneNumberField" promptText="+62..."/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="2">
                                <Label styleClass="field-label" text="Address"/>
                                <TextField fx:id="addressField" promptText="City, country"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="3" GridPane.columnIndex="0">
                                <Label styleClass="field-label" text="Instagram"/>
                                <TextField fx:id="instagramField" promptText="\@username"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="3" GridPane.columnIndex="1">
                                <Label styleClass="field-label" text="LinkedIn"/>
                                <TextField fx:id="linkedInField" promptText="linkedin.com/in/..."/>
                            </VBox>
                        </GridPane>
                    </VBox>
                    <VBox styleClass="card" spacing="14">
                        <Label styleClass="section-title" text="Education"/>
                        <GridPane hgap="16" vgap="14">
                            <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                <Label styleClass="field-label" text="Education level"/>
                                <TextField fx:id="lastEducationLevelField" promptText="e.g. Bachelor's"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <Label styleClass="field-label" text="Institution"/>
                                <TextField fx:id="educationalInstitutionField" promptText="University name"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                <Label styleClass="field-label" text="Field of study"/>
                                <TextField fx:id="fieldOfStudyField" promptText="e.g. Computer Science"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <Label styleClass="field-label" text="Graduation year"/>
                                <TextField fx:id="graduationYearField" promptText="e.g. 2024"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                    <VBox styleClass="card" spacing="14">
                        <Label styleClass="section-title" text="Career"/>
                        <GridPane hgap="16" vgap="14">
                            <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="0">
                                <Label styleClass="field-label" text="Current job"/>
                                <TextField fx:id="currentJobField" promptText="e.g. Software Engineer"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="0" GridPane.columnIndex="1">
                                <Label styleClass="field-label" text="Company"/>
                                <TextField fx:id="companyNameField" promptText=""/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="0">
                                <Label styleClass="field-label" text="Position"/>
                                <TextField fx:id="positionField" promptText="e.g. Junior, Lead"/>
                            </VBox>
                            <VBox spacing="6" GridPane.rowIndex="1" GridPane.columnIndex="1">
                                <Label styleClass="field-label" text="Work experience"/>
                                <TextField fx:id="workExperienceField" promptText="e.g. 3 years in backend"/>
                            </VBox>
                        </GridPane>
                    </VBox>
                    <Label fx:id="errorLabel" styleClass="error-label" managed="false" visible="false"/>
                    <HBox spacing="10" alignment="CENTER_RIGHT">
                        <Button text="Clear" onAction="#handleClearAllButtonAction"/>
                        <Button styleClass="btn-primary" text="Save and continue" onAction="#handleSubmitButtonAction"/>
                    </HBox>
                </VBox>
            </StackPane>
        </ScrollPane>
    </center>
</BorderPane>
