<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="87.0" prefWidth="967.0" style="-fx-background-color: #000000;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.herpathway.controller.MentorHomepageController">
    <top>
        <Pane prefHeight="87.0" prefWidth="967.0" style="-fx-spacing: 10; -fx-background-color: transparent; -fx-padding: 10;">
            <Button layoutX="49.0" layoutY="28.0" onAction="#handleMentorButtonAction" style="-fx-background-color: #000000;" text="Mentor" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Button>
            <Button layoutX="129.0" layoutY="28.0" onAction="#handleApplicationButtonAction" style="-fx-background-color: #000000;" text="Application" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Button>
            <Button layoutX="249.0" layoutY="28.0" onAction="#handleForumButtonAction" style="-fx-background-color: #000000;" text="Forum" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Button>
            <Button layoutX="329.0" layoutY="28.0" onAction="#handleContentButtonAction" style="-fx-background-color: #000000;" text="Content" textFill="WHITE">
                <font>
                    <Font name="System Bold" size="16.0" />
                </font>
            </Button>
            <Label fx:id="profileNameLabel" layoutX="752.0" layoutY="36.0" prefHeight="25.0" prefWidth="124.0" style="-fx-font-size: 14px;" textFill="WHITE" />
            <ImageView fx:id="profileImageView" fitHeight="50" fitWidth="50" layoutX="881.0" layoutY="20.0" onMouseClicked="#handleProfileButtonAction">
                <clip>
                    <Circle fx:id="profileImageClip" centerX="25" centerY="25" radius="25" />
                </clip>
            </ImageView>
        </Pane>
    </top>
    <center>
        <VBox fx:id="contentArea" prefWidth="967.0" />
    </center>
</BorderPane>
