<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.Pane?>

<Pane xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/8.0.171" fx:controller="com.herpathway.controller.MentorProfileController">
    <Label text="Display Name:" layoutX="10" layoutY="10" />
    <TextField fx:id="displayNameField" layoutX="150" layoutY="10" prefWidth="200" />
    
    <Label text="Real Name:" layoutX="10" layoutY="40" />
    <TextField fx:id="realNameField" layoutX="150" layoutY="40" prefWidth="200" />
    
    <Label text="Phone Number:" layoutX="10" layoutY="70" />
    <TextField fx:id="phoneNumberField" layoutX="150" layoutY="70" prefWidth="200" />
    
    <Label text="Email:" layoutX="10" layoutY="100" />
    <TextField fx:id="emailField" layoutX="150" layoutY="100" prefWidth="200" />
    
    <Label text="Address:" layoutX="10" layoutY="130" />
    <TextField fx:id="addressField" layoutX="150" layoutY="130" prefWidth="200" />
    
    <Label text="Instagram:" layoutX="10" layoutY="160" />
    <TextField fx:id="instagramField" layoutX="150" layoutY="160" prefWidth="200" />
    
    <Label text="LinkedIn:" layoutX="10" layoutY="190" />
    <TextField fx:id="linkedInField" layoutX="150" layoutY="190" prefWidth="200" />
    
    <Label text="Last Education Level:" layoutX="10" layoutY="220" />
    <TextField fx:id="lastEducationLevelField" layoutX="150" layoutY="220" prefWidth="200" />
    
    <Label text="Educational Institution:" layoutX="10" layoutY="250" />
    <TextField fx:id="educationalInstitutionField" layoutX="150" layoutY="250" prefWidth="200" />
    
    <Label text="Field of Study:" layoutX="10" layoutY="280" />
    <TextField fx:id="fieldOfStudyField" layoutX="150" layoutY="280" prefWidth="200" />
    
    <Label text="Graduation Year:" layoutX="10" layoutY="310" />
    <TextField fx:id="graduationYearField" layoutX="150" layoutY="310" prefWidth="200" />
    
    <Label text="Current Job:" layoutX="10" layoutY="340" />
    <TextField fx:id="currentJobField" layoutX="150" layoutY="340" prefWidth="200" />
    
    <Label text="Company Name:" layoutX="10" layoutY="370" />
    <TextField fx:id="companyNameField" layoutX="150" layoutY="370" prefWidth="200" />
    
    <Label text="Position:" layoutX="10" layoutY="400" />
    <TextField fx:id="positionField" layoutX="150" layoutY="400" prefWidth="200" />
    
    <Label text="Work Experience:" layoutX="10" layoutY="430" />
    <TextField fx:id="workExperienceField" layoutX="150" layoutY="430" prefWidth="200" />
    
    <Button text="Save" onAction="#handleSaveButtonAction" layoutX="150" layoutY="470"/>
</Pane>
